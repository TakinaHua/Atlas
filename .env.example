# Optional TypeScript Express API port (default 8000). Export ATLAS_API_URL in your shell
# as well if changing the port, so Next can proxy the API endpoints.
API_PORT=8000
# ATLAS_API_URL=http://127.0.0.1:8000
# Optional compatible Photon endpoint (restart API after changing).
# PHOTON_URL=https://photon.komoot.io/api/
# Optional OSRM-compatible driving service (restart API after changing).
# OSRM_URL=https://router.project-osrm.org
