{
  "name": "atlas",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": ".venv/bin/python backend/manage.py runserver 127.0.0.1:8000",
    "dev:web": "npm run dev --workspace=@atlas/frontend",
    "build": "npm run build --workspace=@atlas/frontend",
    "start": "npm run start --workspace=@atlas/frontend",
    "test": ".venv/bin/python backend/manage.py test trips && node --test archive/vanilla-frontend/tests/*.test.js",
    "test:browser": "playwright test",
    "check": "npm run typecheck --workspace=@atlas/frontend && .venv/bin/python backend/manage.py check && prettier --check . && .venv/bin/black --check backend",
    "format": "prettier --write . && .venv/bin/black backend"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.8.0"
  },
  "overrides": {
    "shell-quote": "^1.11.0"
  }
}
