{
  "name": "atlas",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch backend/server.js",
    "dev:web": "npm run dev --workspace=@atlas/frontend",
    "build": "npm run build --workspace=@atlas/frontend",
    "start": "concurrently -k -n api,web \"node --env-file-if-exists=.env backend/server.js\" \"npm run start --workspace=@atlas/frontend\"",
    "test": "node --test tests/server.test.js && node --test archive/vanilla-frontend/tests/*.test.js",
    "test:browser": "playwright test",
    "check": "npm run typecheck --workspace=@atlas/frontend && prettier --check frontend backend/server.js tests docs/architecture.md docs/backend-plan.md README.md package.json playwright.config.ts",
    "format": "prettier --write frontend backend/server.js tests docs/architecture.md docs/backend-plan.md README.md package.json playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.8.0"
  },
  "overrides": {
    "shell-quote": "^1.11.0"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
